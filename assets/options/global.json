          "label": "$国际服(haoplay)",
          "pipeline_override": {
            "openGF2GameApp": {
              "package": "com.haoplay.game.and.exilium/.ExiliumMainActivity"
            },
            "StopGame": {
              "package": "com.haoplay.game.and.exilium"
            }
          }
        }
      ]
    },
    "通用战斗允许缺员开始": {
      "type": "switch",
      "label": "$通用战斗允许缺员开始",
      "description": "$通用战斗缺员开始说明",
      "default_case": "No",
      "cases": [
        {
          "name": "No"
        },
        {
          "name": "Yes",
          "pipeline_override": {
