              "package": "com.Sunborn.SnqxExilium/.ExiliumMainActivity"
            },
            "StopGame": {
              "package": "com.Sunborn.SnqxExilium"
            }
          }
        },
        {
          "name": "B 服",
          "label": "$B 服",
          "pipeline_override": {
            "openGF2GameApp": {
              "package": "com.Sunborn.SnqxExilium.bilibili/.ExiliumMainActivity"
            },
            "StopGame": {
              "package": "com.Sunborn.SnqxExilium.bilibili"
            }
          }
        },
        {
          "name": "美服(dark winter)",
          "label": "$美服(dark winter)",
          "pipeline_override": {
            "openGF2GameApp": {
              "package": "com.Sunborn.SnqxExilium.Glo/.ExiliumMainActivity"
