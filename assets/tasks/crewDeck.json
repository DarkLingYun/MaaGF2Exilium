{
  "task": [
    {
      "name": "活动层",
      "label": "$活动层",
      "entry": "开始活动层任务",
      "option": [
        "美味烹调",
        "茶歇一刻",
        "领取逸趣导算进度奖励",
        "浇花"
      ],
      "default_check": true
    }
  ],
  "option": {
    "浇花": {
      "type": "switch",
      "label": "$浇花",
      "cases": [
        {
          "name": "Yes",
          "option": [
            "种子选择",
            "允许铲除重种"
          ],
          "pipeline_override": {
            "Planting-Start": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "Planting-Start": {
              "enabled": false
            }
          }
        }
      ]
    },
    "种子选择": {
      "label": "$种子选择",
      "cases": [
        {
          "name": "TricoloredPansy",
          "label": "$三色堇",
          "pipeline_override": {
            "Planting-SelectSeed": {
              "expected": [
                "^三色堇$",
                "^Tricolored Pansy$"
              ]
            },
            "Planting-FlowerSame": {
              "expected": [
                "^三色堇$",
                "^Tricolored Pansy$"
              ]
            },
            "Planting-FlowerDiffers": {
              "expected": [
                "^三色堇$",
                "^Tricolored Pansy$"
              ]
            }
          }
        },
        {
          "name": "CobaltBeauty",
          "label": "$幽蓝美人",
          "pipeline_override": {
            "Planting-SelectSeed": {
              "expected": [
                "^幽蓝美人$",
                "^Cobalt Beauty$"
              ]
            },
            "Planting-FlowerSame": {
              "expected": [
                "^幽蓝美人$",
                "^Cobalt Beauty$"
              ]
            },
            "Planting-FlowerDiffers": {
              "expected": [
                "^幽蓝美人$",
                "^Cobalt Beauty$"
              ]
            }
          }
        },
        {
          "name": "Hydrangea",
          "label": "$紫阳花",
          "pipeline_override": {
            "Planting-SelectSeed": {
              "expected": [
                "^紫阳花$",
                "^Hydrangea$"
              ]
            },
            "Planting-FlowerSame": {
              "expected": [
                "^紫阳花$",
                "^Hydrangea$"
              ]
            },
            "Planting-FlowerDiffers": {
              "expected": [
                "^紫阳花$",
                "^Hydrangea$"
              ]
            }
          }
        },
        {
          "name": "Tomato",
          "label": "$番茄",
          "pipeline_override": {
            "Planting-SelectSeed": {
              "expected": [
                "^番茄$",
                "^Tomato$"
              ]
            },
            "Planting-FlowerSame": {
              "expected": [
                "^番茄$",
                "^Tomato$"
              ]
            },
            "Planting-FlowerDiffers": {
              "expected": [
                "^番茄$",
                "^Tomato$"
              ]
            }
          }
        }
      ]
    },
    "允许铲除重种": {
      "type": "switch",
      "label": "$允许铲除重种",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "Planting-Replant": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "Planting-Replant": {
              "enabled": false
            }
          }
        }
      ]
    },
    "领取逸趣导算进度奖励": {
      "type": "switch",
      "label": "$领取逸趣导算进度奖励",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "开始逸趣导算任务": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "开始逸趣导算任务": {
              "enabled": false
            }
          }
        }
      ]
    },
    "饮品加成": {
      "label": "$饮品加成",
      "cases": [
        {
          "name": "星标饮品",
          "label": "$星标饮品",
          "pipeline_override": {
            "选择饮品-茶歇一刻": {
              "template": "活动层/茶歇一刻-星标.png"
            }
          }
        },
        {
          "name": "今日特饮",
          "label": "$今日特饮",
          "pipeline_override": {
            "TeaTime-ScrollToSpecial": {
              "enabled": true
            },
            "TeaTime-SelectSpecialDrink": {
              "enabled": true
            },
            "TeaTime-SpecialSelected": {
              "enabled": true
            },
            "TeaTime-SpecialNotAvailable": {
              "enabled": true
            }
          }
        }
      ],
      "description": "$饮品加成说明"
    },
    "茶歇一刻": {
      "type": "switch",
      "label": "$茶歇一刻",
      "cases": [
        {
          "name": "Yes",
          "option": [
            "饮品加成",
            "茶歇一刻对话"
          ],
          "pipeline_override": {
            "开始茶歇一刻任务": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "开始茶歇一刻任务": {
              "enabled": false
            }
          }
        }
      ]
    },
    "美味烹调": {
      "type": "switch",
      "label": "$美味烹调",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "开始美味烹调任务": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "开始美味烹调任务": {
              "enabled": false
            }
          }
        }
      ]
    },
    "茶歇一刻对话": {
      "label": "$茶歇一刻对话",
      "description": "$茶歇一刻对话说明",
      "cases": [
        {
          "name": "跳过对话",
          "label": "$跳过对话",
          "pipeline_override": {
            "跳过动画-茶歇一刻": {
              "enabled": true
            },
            "TeaTime-TurnOnAuto": {
              "enabled": false
            },
            "TeaTime-WaitForTopics": {
              "enabled": false
            },
            "TeaTime-PickUnreadTopic": {
              "enabled": false
            },
            "TeaTime-PickAnyTopic": {
              "enabled": false
            }
          }
        },
        {
          "name": "选择未读话题",
          "label": "$选择未读话题",
          "pipeline_override": {
            "跳过动画-茶歇一刻": {
              "enabled": false
            },
            "TeaTime-TurnOnAuto": {
              "enabled": true
            },
            "TeaTime-WaitForTopics": {
              "enabled": true
            },
            "TeaTime-PickUnreadTopic": {
              "enabled": true
            },
            "TeaTime-PickAnyTopic": {
              "enabled": true
            }
          }
        }
      ]
    }
  }
}
