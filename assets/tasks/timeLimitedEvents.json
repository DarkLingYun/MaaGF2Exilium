{
  "task": [
    {
      "name": "版本活动日常",
      "label": "$版本活动日常",
      "entry": "VersionActivityTask",
      "option": [
        "物资模式活动选择",
        "物资商品兑换",
        "完成活动内每日任务"
      ],
      "default_check": true,
      "description": "$物资模式说明"
    }
  ],
  "option": {
    "物资商品兑换": {
      "type": "switch",
      "label": "$物资商品兑换",
      "cases": [
        {
          "name": "Yes",
          "pipeline_override": {
            "enterVersionActivityItemExchange": {
              "enabled": true
            }
          }
        },
        {
          "name": "No",
          "pipeline_override": {
            "enterVersionActivityItemExchange": {
              "enabled": false
            }
          }
        }
      ]
    },
    "完成活动内每日任务": {
      "label": "$完成活动内每日任务",
      "description": "$完成活动内每日任务说明",
      "default_case": "NO",
      "cases": [
        {
          "name": "NO"
        },
        {
          "name": "YES",
          "pipeline_override": {
            "EventDaily-Start": {
              "enabled": true
            }
          }
        }
      ]
    }
  }
}
