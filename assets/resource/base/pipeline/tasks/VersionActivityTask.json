{
    "VersionActivityTask": {
        "doc": "版本活动日常",
        "next": [
            "enterVersionActivityTask",
            "[JumpBack]returnToHomePage"
        ]
    },
    "enterVersionActivityTask": {
        "doc": "正式进入版本活动任务，先验证是否在首页，然后判断是否存在活动标签，不存在就识别主页结束任务",
        "recognition": "OCR",
        "expected": "^战役推进$",
        "next": [
            "clickVersionActivityTagButton",
            "版本活动滑动选择-重置"
        ]
    },
    "版本活动滑动选择-重置": {
        "doc": "多个活动存在，需滑动选择",
        "recognition": "DirectHit",
        "action": "Swipe",
        "begin": [
            82,
            88,
            162,
            113
        ],
        "end": [
            75,
            301,
            171,
            113
        ],
        "post_wait_freezes": {
            "time": 600,
            "target": [
                2,
                74,
                201,
                346
            ]
        },
        "next": [
            "clickVersionActivityTagButton",
            "[JumpBack]版本活动滑动选择",
            "HomePage"
        ]
    },
    "版本活动滑动选择": {
        "doc": "多个活动存在，需滑动选择",
        "recognition": "Custom",
        "custom_recognition": "scroll_end",
        "custom_recognition_param": {
            "roi": [
                2,
                74,
                201,
                346
            ],
            "max_scroll": 2
        },
        "action": "Swipe",
        "begin": [
            71,
            90,
            174,
            116
        ],
        "end": [
            70,
            0,
            175,
            74
        ],
        "end_hold": 1000
    },
    "clickVersionActivityTagButton": {
        "doc": "点击版本活动标签按钮,版本更新后更改识别字段",
        "recognition": "OCR",
        "roi": [
            33,
            37,
            259,
            414
        ],
        "expected": "^$",
        "action": "Click",
        "post_wait_freezes": 5000,
        "next": [
            "[JumpBack]开始活动内每日任务",
            "[JumpBack]switchVersionActivityChapter",
            "enterVersionActivityResourceSweep",
            "enterVersionActivityItemExchange",
            "returnToHomePage"
        ]
    },
    "switchVersionActivityChapter": {
        "doc": "切换版本活动章节(大型活动), 默认false",
        "enabled": false,
        "recognition": "OCR",
        "expected": "^$",
        "max_hit": 1,
        "post_wait_freezes": 800,
        "action": "Click"
    }
}