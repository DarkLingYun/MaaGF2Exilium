{
    "StartGame": {
        "doc": "启动游戏流程",
        "timeout": 150000,
        "rate_limit": 3000,
        "next": [
            "[JumpBack]StartGame_loading",
            "[JumpBack]clickCloseWindowButton",
            "[JumpBack]clickHomeButton",
            "[JumpBack]clickBackButton",
            "[JumpBack]点击空白处关闭-通用",
            "[JumpBack]指挥官等级提升-通用",
            "[JumpBack]退出活动层-活动层通用",
            "StartGame_HomePage_Check",
            "[JumpBack]StartGame_loadingSource",
            "[JumpBack]StartGame_retryLogin",
            "StartGame_notLoginIn",
            "[JumpBack]StartGame_clickStart",
            "[JumpBack]StartGame_downloadResource",
            "[JumpBack]StartGame_unzipResources",
            "[JumpBack]StartGame_restartGF2Game",
            "[JumpBack]openGF2GameApp"
        ]
    },
    "StartGame_HomePage_Check": {
        "doc": "任务出口，识别到主页的战役推进后结束任务",
        "focus": {
            "Node.Action.Starting": "已进入游戏主页"
        },
        "recognition": "OCR",
        "pre_wait_freezes": {
            "time": 2000,
            "target": [
                0,
                0,
                337,
                109
            ]
        },
        "expected": "战役推进"
    },
    "StartGame_loadingSource": {
        "recognition": "OCR",
        "expected": [
            "资源加载中"
        ]
    },
    "StartGame_clickStart": {
        "recognition": "OCR",
        "expected": [
            "点击开始",
            "击开始$",
            "点击开"
        ],
        "action": "Click"
    },
    "openGF2GameApp": {
        "action": "StartApp",
        "max_hit": 100,
        "package": "com.Sunborn.SnqxExilium/.ExiliumMainActivity"
    },
    "StartGame_downloadResource": {
        "recognition": "OCR",
        "expected": "下载资源"
    },
    "StartGame_unzipResources": {
        "recognition": "OCR",
        "expected": "解压"
    },
    "StartGame_restartGF2Game": {
        "recognition": "OCR",
        "expected": "确认",
        "action": "Click"
    },
    "StartGame_进入整备室": {
        "doc": "进入游戏后可能仍在加载（现象为像新手一样的主页），进入整备室再退出即可恢复",
        "recognition": "OCR",
        "expected": "整备室",
        "action": "Click",
        "next": [
            "[JumpBack]StartGame_loading",
            "StartGame_进入整备室",
            "clickBackButton"
        ]
    },
    "StartGame_loading": {
        "doc": "外服进入主页后仍可能需要等待loading",
        "recognition": "FeatureMatch",
        "post_delay": 2000,
        "green_mask": true,
        "template": [
            "其他/loading_green_1.png",
            "其他/loading_green_2.png"
        ],
        "roi": [
            482,
            215,
            309,
            278
        ]
    },
    "StartGame_retryLogin": {
        "doc": "外服用户登录可能需要重试/确定用户协议",
        "recognition": "OCR",
        "expected": [
            "重试",
            "确定"
        ],
        "action": "Click"
    },
    "StartGame_notLoginIn": {
        "doc": "用户未登录，弹出登录提示，直接退出游戏",
        "recognition": "OCR",
        "expected": [
            "登录方式",
            "使用游客登录",
            "散爆ID",
            "通过Google登录",
            "通过邮箱登录"
        ],
        "post_wait_freezes": 0,
        "focus": {
            "Node.Action.Starting": "用户未登录，请先登录游戏"
        },
        "action": "StopTask"
    }
}