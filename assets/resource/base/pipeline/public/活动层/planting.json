    "Planting-ClickWater": {
        "doc": "点击培养页面的「浇灌」；按钮文字下方是次数，圆形按钮在文字上方，按偏移点按钮本体",
        "recognition": "OCR",
        "expected": [
            "^浇灌$"
        ],
        "action": "Click",
        "target": true,
        "target_offset": [
            0,
            -45,
            0,
            0
        ],
        "post_wait_freezes": 1000,
        "next": [
            "[JumpBack]点击空白处关闭-通用",
