    "Planting-WaterFinished": {
        "doc": "浇灌动画约 5 秒，期间整屏被盖住，「栽培天数」不出现；等奖励弹窗关掉、回到培养页面再返回活动层（不能直接写返回活动层，那是 DirectHit，会打断动画）",
        "recognition": "OCR",
        "expected": [
            "栽培天数",
            "生长阶段"
        ],
        "timeout": 30000,
        "next": [
            "返回活动层-活动层通用"
        ]
