            "Planting-ConfirmSow"
        ]
    },
    "已进入培养页面": {
        "doc": "培养页面已打开（右侧信息栏出现「栽培天数」/「生长阶段」）；刚播种/铲除后的动画要播完，按钮才能点",
        "recognition": "OCR",
        "expected": [
            "栽培天数",
            "生长阶段"
        ],
        "post_delay": 800,
        "next": [
