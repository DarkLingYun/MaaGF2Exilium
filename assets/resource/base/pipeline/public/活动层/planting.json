{
    "Planting-Start": {
        "doc": "浇花：打开逸趣导算的「栽培」页签",
        "max_hit": 1,
        "next": [
            "Planting-SelectPlantTab",
            "Planting-OpenRecreationPanel"
        ]
    },
    "Planting-OpenRecreationPanel": {
        "doc": "点击活动层里的「逸趣导算」进入面板",
        "recognition": "TemplateMatch",
        "template": "活动层/逸趣导算.png",
        "green_mask": true,
        "order_by": "Score",
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "Planting-SelectPlantTab",
            "Planting-OpenRecreationPanel"
        ]
    },
    "Planting-SelectPlantTab": {
        "doc": "点击逸趣导算面板顶部的「栽培」页签",
        "recognition": "OCR",
        "expected": [
            "^栽培$"
        ],
        "roi": [
            50,
            40,
            520,
            90
        ],
        "action": "Click",
        "post_wait_freezes": 800,
        "next": [
            "Planting-ConfirmPlantTab",
            "Planting-AlreadyPlanted",
            "Planting-SelectPlantTab"
        ]
    },
    "Planting-ConfirmPlantTab": {
        "doc": "确认栽培页签已打开：未种植时页面中间有「当前未种植花朵」提示",
        "recognition": "OCR",
        "expected": [
            "当前未种植花朵",
            "未种植花朵"
        ],
        "next": [
            "Planting-ClickProceed"
        ]
    },
    "Planting-AlreadyPlanted": {
        "doc": "栽培页已有花：左侧卡片显示「花朵盛放值」；接下来比对花名与所选种子",
        "recognition": "OCR",
        "expected": [
            "花朵盛放值"
        ],
        "next": [
            "Planting-FlowerSame",
            "Planting-FlowerDiffers"
        ]
    },
    "Planting-FlowerSame": {
        "doc": "栽培页显示的正是所选种子种出的花",
        "recognition": "OCR",
        "expected": [
            "^三色堇$"
        ],
        "next": [
            "Planting-WateringNeeded",
            "Planting-AlreadyWatered"
        ]
    },
    "Planting-FlowerDiffers": {
        "doc": "栽培页显示的花与所选种子不同",
        "recognition": "OCR",
        "expected": [
            "^三色堇$"
        ],
        "inverse": true,
        "next": [
            "Planting-Replant",
            "Planting-WateringNeeded",
            "Planting-AlreadyWatered"
        ]
    },
    "Planting-Replant": {
        "doc": "允许铲除重种：先进入培养页面铲除，再重新播种所选种子；默认关闭，由任务选项开启",
        "enabled": false,
        "next": [
            "Planting-EnterCultivationToReplant"
        ]
    },
    "Planting-WateringNeeded": {
        "doc": "栽培页显示今日未浇水，进入培养页面浇灌",
        "recognition": "OCR",
        "expected": [
            "今日未浇水"
        ],
        "next": [
            "Planting-EnterCultivationToWater"
        ]
    },
