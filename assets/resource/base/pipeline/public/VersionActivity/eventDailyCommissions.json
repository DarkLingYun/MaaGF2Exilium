{
    "EventDaily-Start": {
        "doc": "活动内每日任务(如影院通告): 逐行点击「前往」并自律 1 次, 直到该行不再显示「前往」; 跳转后不是可自律关卡(如实兵演习)则跳过该行; 体力不足(弹出情报拼图补充)则取消并结束, 不购买体力。默认关闭, 由 interface 选项「完成活动内每日任务」开启。用进度数字 x/y 识别委托页, 与活动名称无关。完成的委托会上移到顶部, 未完成的只会下移, 所以自上而下逐行检查不会漏掉; 一次自律可能同时完成多行(如决策构象也算补给作战)",
        "enabled": false,
        "max_hit": 1,
        "recognition": "OCR",
        "expected": "^\\d+/\\d+$",
        "roi": [
            515,
            235,
            85,
            290
        ],
        "next": [
            "EventDaily-Row1-Proceed",
            "EventDaily-Row2-Proceed",
            "EventDaily-Row3-Proceed",
            "EventDaily-Done"
        ]
    },
