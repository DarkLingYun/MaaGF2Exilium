{
    // Manual EN overrides for Boundary Advance. Kept out of _auto_en_ocr.json because
    // these need roi/recognition changes, not just an `expected` translation.
    // The generator SKIPS any node defined here.

    // CN used a tiny roi tuned to short zh text; the EN banner
    // "All rewards for current difficulty obtained" is a wide bar elsewhere,
    // so scan full-screen for the unique phrase.
    "boundaryAdvanceDelegateRewardFull": {
        "recognition": "OCR",
        "expected": "All rewards for current difficulty obtained",
        "roi": [0, 0, 1280, 720],
        "focus": {
            "Node.Action.Succeeded": "All Boundary Push rewards claimed"
        }
    },

    // CN detects the crystal-collection "Claim All" button via a template crop of
    // the Chinese button (边界推进/一键领取.png), which never matches the EN button.
    // Switch to OCR on the verified EN text "Claim All" within the base button roi.
    // PROVISIONAL: verified from a screenshot of the claimable state; the dispatch
    // (一键派遣) and not-claimable (不可领取) states still need EN screenshots.
    "boundaryAdvanceDelegateOneClickClaim": {
        "recognition": "OCR",
        "expected": "Claim All",
        "roi": [799, 530, 481, 190],
        "focus": {
            "Node.Action.Starting": "Claim Boundary Push rewards"
        }
    },

    // The "Claim All" text is present whether the button is ENABLED (orange, claimable)
    // or DISABLED (grey, nothing to claim) - so OCR alone loops on the greyed button.
    // CN distinguished them with a template of the enabled button; do the EN equivalent
    // with a ColorMatch on the DISABLED grey fill. Measured over ADB: the disabled
    // button roi is ~72% flat grey ~(39,40,40); when enabled the fill is saturated
    // orange (0 px in this grey range). This node is checked BEFORE the OCR claim, so
    // a greyed button -> match -> exit; an orange button -> no match -> OCR claims it.
    "boundaryAdvanceDelegateNotClaimable": {
        "recognition": "ColorMatch",
        "method": 4,
        "lower": [26, 26, 26],
        "upper": [60, 60, 62],
        "roi": [955, 630, 280, 60],
        "count": 9000,
        "next": [
            "exitBoundaryAdvance"
        ]
    }
}
